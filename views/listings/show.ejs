<% layout("/layouts/boilerplate") %>

    <script>
        const mapToken = "<%= process.env.MAP_TOKEN%>"
        let listing = <%- JSON.stringify(listing) %>;
    </script>

    <div class="mx-auto" style="max-width: 800px;">

        <h1 class="my-4">
            <%= listing.title %>
        </h1>

        <div class="card listing-card">

            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing Image">

            <div class="card-body">
                <p class="card-text"><i>Owned by <%= listing.owner.username %></i></p>

                <p class="card-text">
                    <%= listing.description %>
                </p>

                <p class="card-text">₹ <%= listing.price.toLocaleString("en-IN") %>
                </p>

                <p class="card-text">
                    <%= listing.location %>
                </p>

                <p class="card-text">
                    <%= listing.country %>
                </p>

                <%if(currUser && listing.owner._id.equals(currUser._id)){%>
                    <div class="d-flex gap-2 my-4">

                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger">
                            Edit
                        </a>

                        <form action="/listings/<%= listing._id %>/delete?_method=DELETE" method="POST">

                            <button class="btn btn-dark">
                                Delete
                            </button>

                        </form>

                    </div>
                    <%}%>

            </div>

        </div>

        <!--Map -->
        <h3 class="mt-3">Where you’ll be</h3>
        <div id="map"></div>


        <div>

            <%if(currUser){%>
                <!-- Review giving scetion -->
                <hr />
                <h4>Leave a Review</h4>

                <form action="/listings/<%= listing.id %>/review" method="post" novalidate class="needs-validation">

                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                            aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>

                    <div class="my-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" rows="4" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please Enter a comment</div>
                    </div>

                    <button class="btn btn-outline-dark mb-3">Submit</button>
                </form>
                <%}%>

                    <%if(listing.reviews.length){%>
                        <hr>
                        <!-- all comment show-casing section -->
                        <div class="row g-3 mb-3">
                            <% for(let review of listing.reviews){ %>
                                <!-- 1. The Column handles width and spacing -->
                                <div class="col-12 col-md-6">
                                    <!-- 2. The Card sits inside with padding around it -->
                                    <div class="card h-100 p-3">
                                        <div class="card-body">
                                            <h5 class="card-title">@<%= review.author.username %>
                                            </h5>
                                            <p class="starability-result star-show" data-rating="<%= review.rating %>">
                                            </p>
                                            <p class="card-text">
                                                <%= review.comment %>
                                            </p>

                                        </div>

                                        <%if(currUser && currUser._id.equals(review.author._id)){%>
                                            <form
                                                action="/listings/<%= listing.id %>/review/<%= review.id %>?_method=DELETE"
                                                method="POST" class="d-flex justify-content-end">
                                                <button class="btn btn-sm" style="color: red;"><i
                                                        class="fa-solid fa-trash-can"></i></button>
                                            </form>
                                            <%}%>
                                    </div>
                                </div>
                                <% } %>
                        </div>
        </div>
        <%}%>

    </div>

    </div>

    <script src="/js/map.js"></script>