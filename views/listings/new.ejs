<%- layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h1 class="mt-5">Create a new Listing</h1>
            <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" placeholder="Enter catchy title" class="form-control"
                        required>
                    <div class="invalid-feedback">Enter Title</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">description</label>
                    <textarea name="listing[description]" placeholder="Enter the description" class="form-control"
                        required></textarea>
                    <div class="invalid-feedback">Enter description</div>
                </div>

                <div class="mb-3">
                    <label for="imageInput" class="form-label">Upload Image</label>
                    <input type="file" id="imageInput" name="listing[image]" placeholder="Enter the image link/URL"
                        class="form-control" required>
                    <div class="invalid-feedback" id="errorMsg">Please choose the image</div>
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>

                    <select name="listing[category]" class="form-select form-select-sm"
                        aria-label="Small select example" id="category" required>
                        <option value="" selected disabled>Select the category</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Castles">
                            Castles</option>
                        <option value="Pools">
                            Pools</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Beach">Beach</option>
                    </select>

                    <div class="invalid-feedback">Select the category</div>

                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input type="text" name="listing[price]" placeholder="1200" class="form-control" required>
                        <div class="invalid-feedback">Enter valid price</div>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="listing[location]" placeholder="Jaipur" class="form-control" required>
                        <div class="invalid-feedback">Enter location</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" placeholder="India" class="form-control" required>
                    <div class="invalid-feedback">Enter Country</div>
                </div>

                <button class="btn btn-primary my-5 add-btn">Add</button>
            </form>
        </div>
    </div>

    <script src="/js/imageSizeLimit.js"></script>