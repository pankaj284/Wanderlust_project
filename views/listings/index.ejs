<% layout("/layouts/boilerplate") %>

    <style>
        .filters {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .filter-wrapper {
            display: flex;
            align-items: center;
            flex: 1;
            min-width: 0;
            position: relative;
        }

        .filter-container {
            display: flex;
            overflow-x: auto;
            overflow-y: hidden;
            gap: 2rem;
            scroll-behavior: smooth;
            scrollbar-width: none;
            flex: 1;
        }

        .filter-container::-webkit-scrollbar {
            display: none;
        }

        .filter {
            text-align: center;
            opacity: 0.7;
            cursor: pointer;
            flex: 0 0 auto;
        }

        .filter:hover {
            opacity: 1;

        }

        .filter p {
            font-size: 0.8rem;
        }

        .filter-arrow {
            border: none;
            background: white;
            cursor: pointer;
            font-size: 1rem;
            padding: 0.5rem;
            z-index: 1;
        }

        .tax-switch {
            flex-shrink: 0;
        }

        .hide {
            display: none;
        }

        #switchCheckReverse {
            cursor: pointer;
        }


        @media (min-width: 1200px) {

            #rightBtn,
            #leftBtn {
                display: none;
            }
        }

        .tax-switch {
            border: 1px solid black;
            padding: 0.5rem;
            border-radius: 1rem;
        }

        .filter-container a {
            color: black;
            text-decoration: none;
        }
    </style>

    <body>

        <div class="filters mt-3">
            <div class="filter-wrapper">

                <button class="filter-arrow" id="leftBtn">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <div class="filter-container" id="filterContainer">
                    <a href="/listings?category=Trending" class="filter-link">
                        <div class="filter" id="Trending">
                            <div><i class="fa-solid fa-fire"></i></div>
                            <p><b>Trending</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Rooms" class="filter-link">
                        <div class="filter" id="Rooms">
                            <div><i class="fa-solid fa-bed"></i></div>
                            <p><b>Rooms</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Iconic Cities" class="filter-link">
                        <div class="filter" id="Iconic Cities">
                            <div><i class="fa-solid fa-tree-city"></i></div>
                            <p><b>Iconic Cities</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Mountains" class="filter-link">
                        <div class="filter" id="Mountains">
                            <div><i class="fa-solid fa-mountain"></i></div>
                            <p><b>Mountains</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Castles" class="filter-link">
                        <div class="filter" id="Castles">
                            <div><i class="fa-brands fa-fort-awesome"></i></div>
                            <p><b>Castles</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Pools" class="filter-link">
                        <div class="filter" id="Pools">
                            <div><i class="fa-solid fa-person-swimming"></i></div>
                            <p><b>Pools</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Camping" class="filter-link">
                        <div class="filter" id="Camping">
                            <div><i class="fa-solid fa-campground"></i></div>
                            <p><b>Camping</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Farms" class="filter-link">
                        <div class="filter" id="Farms">
                            <div><i class="fa-solid fa-cow"></i></div>
                            <p><b>Farms</b></p>
                        </div>
                    </a>


                    <a href="/listings?category=Arctic" class="filter-link">
                        <div class="filter" id="Arctic">
                            <div><i class="fa-solid fa-snowflake"></i></div>
                            <p><b>Arctic</b></p>
                        </div>
                    </a>

                    <a href="/listings?category=Beach" class="filter-link">
                        <div class="filter" id="Beach">
                            <div><i class="fa-solid fa-umbrella-beach"></i></div>
                            <p><b>Beach</b></p>
                        </div>
                    </a>

                </div>

                <button class="filter-arrow" id="rightBtn">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

            </div>

            <div class="tax-switch">
                <div class="form-check form-switch form-check-reverse">
                    <input class="form-check-input tax-show-btn" type="checkbox" id="switchCheckReverse">
                    <label class="form-check-label" for="switchCheckReverse">
                        Display taxes
                    </label>
                </div>
            </div>


        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <%for(let listing of allListings){%>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="col">
                        <div class="card listing-card">
                            <img src="<%=listing.image.url %>" class="card-img-top" alt="listing-image">
                            <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b> <br>
                                    &#8377; <%= listing.price.toLocaleString("en-IN") %>/night
                                        <i class="tax hide"> &nbsp; &nbsp; +18% GST</i>
                                </p>
                            </div>
                        </div>
                    </div>
                </a>
                <%}%>
        </div>
    </body>

    <script>
        const filterContainer = document.getElementById("filterContainer");
        const leftBtn = document.getElementById("leftBtn");
        const rightBtn = document.getElementById("rightBtn");
        const taxToggleBtn = document.querySelector(".tax-show-btn");
        const taxEls = document.getElementsByClassName("tax");

        taxToggleBtn.addEventListener('click', () => {
            for (taxEl of taxEls) {
                taxEl.classList.toggle("hide");
            }
        })

        rightBtn.addEventListener("click", () => {
            filterContainer.scrollBy({
                left: 30,
                behavior: "smooth"
            });
        });

        leftBtn.addEventListener("click", () => {
            filterContainer.scrollBy({
                left: -30,
                behavior: "smooth"
            });
        });


    </script>